# Public Firebase web app configuration (not service-account credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server only
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_ADMIN_UID=
REGISTRATION_HMAC_SECRET=
SITE_ORIGIN=http://localhost:3000
# Only set if the reverse proxy overwrites this header with a single verified IP.
TRUSTED_CLIENT_IP_HEADER=
# Optional server-only Telegram notifications. Leave chat ID empty until ready.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Local emulator only. Never enable on a public deployment.
USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
